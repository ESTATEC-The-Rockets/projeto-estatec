DB_URL=jdbc:mysql://localhost:3306/db_estatec?sslMode=REQUIRED
DB_USER=estatec
DB_PASSWORD=replace-me
ESTATEC_FRONTEND_ORIGIN=http://estatec.lab
ESTATEC_ADMIN_EMAIL=admin@example.com
ESTATEC_ADMIN_PASSWORD_HASH=replace-with-bcrypt-hash
ESTATEC_ACCESS_API_KEY=replace-with-random-device-key

# SQL_INIT_MODE=never desabilita dados de demonstracao
SQL_INIT_MODE=always
# true quando a API usar HTTPS
SESSION_COOKIE_SECURE=false
